rules_version = '2';
// 라이즈 컨디셔닝 — Firestore 보안 규칙 (P06).
// 모든 데이터 접근은 Go 백엔드(Admin SDK — 규칙 우회)를 통해서만 이뤄진다.
// 클라이언트(앱·어드민)는 Firestore에 직접 접근하지 않으므로 전면 차단이 올바른 기본값.
// 이 파일이 규칙의 소스 오브 트루스 — 콘솔에서 수정하지 말 것(배포가 덮어씀).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

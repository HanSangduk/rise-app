# 라이즈 컨디셔닝(PT데스크) 백엔드 환경변수

# HTTP 포트(Cloud Run은 자동 주입)
PORT=8080

# --- DB ---
# false면 인메모리 스토어(개발·테스트). true면 Firestore(GCP_PROJECT 필요).
USE_FIRESTORE=false
GCP_PROJECT=
# 로컬 에뮬레이터 사용 시(선택): firestore 에뮬레이터 주소
# FIRESTORE_EMULATOR_HOST=localhost:8081

# --- 인증 ---
# 비우면 dev 헤더 인증(X-Dev-Role: owner|trainer|member + X-Dev-Uid) — 로컬 개발 전용.
# 설정하면 Authorization: Bearer <Firebase ID token>을 검증한다(운영 배포 시 필수).
# USE_FIRESTORE=true와 함께 쓸 땐 필수 — 비어 있으면 서버가 기동을 거부한다
# (실 DB에 붙은 채 dev 헤더 인증으로 뜨면 헤더 한 줄로 누구나 대표가 된다).
FIREBASE_PROJECT=

# --- 데모 시딩(v1.4) ---
# true면 인메모리 스토어에 데모 데이터를 시딩한다(스태프 3·회원 5·패스·예약·미납 결제·계약·수업기록).
# 어드민 데모: X-Dev-Uid owner1|t1|t2 · 회원 앱 데모: X-Dev-Uid member1. Firestore 모드에선 무시.
DEV_SEED=false

# --- 센터 ---
# v1은 단일 센터(라이즈 컨디셔닝) 전제. 센터 생성 API가 없어 이 값으로 부트스트랩한다(README 갭 참고).
DEFAULT_CENTER_ID=rise

# --- 체크인(P44 → P49) ---
# CHECKIN_QR_TOKEN은 **삭제됐다**(계약 v2.23). 여기에 적어도 서버는 읽지 않는다.
#
# 데스크 체크인 토큰은 이제 센터 문서에 저장되는 서버 발급 비밀이다. 대표가 어드민 설정의
# "데스크 체크인 QR"에서 발급 버튼을 누르면 서버가 crypto/rand로 만들어 저장하고, 그 QR을
# 인쇄해 붙인다. 사람이 값을 알거나 옮겨 적을 일이 없다.
#
#   GET  /v1/center/checkin-qr          (owner 전용) 현재 토큰 조회
#   POST /v1/center/checkin-qr/rotate   (owner 전용) 재발급 — 직전 인쇄물이 즉시 무효가 된다
#
# 로컬(DEV_SEED=true, 인메모리)은 SeedDemo가 고정 토큰 `rise-desk-checkin`을 심는다 —
# 앱의 CHECKIN_QR_TOKEN dart-define 기본값과 같은 값이라 카메라 없는 시뮬레이터에서도
# 셀프 체크인이 돈다. DEV_SEED 없이 띄우면 미발급 상태라 self_qr은 400으로 거부되고
# ("어드민 설정에서 발급해 주세요"), 어드민에서 한 번 발급하면 그때부터 동작한다.
#
# 기존 배포에 이 변수가 남아 있어도 무해하다(읽히지 않고 기동도 막지 않는다). 지우는 것이 권고.

# --- Cloud Storage(v2.11 파기 → v2.25 업로드) ---
# 서버가 Admin SDK로 만지는 버킷. 예: rize-218c1.firebasestorage.app
#
# **두 경로가 쓰고, 미설정 시 동작이 정반대다.**
#
#   파기(v2.11 회원탈퇴)        미설정 → 조용한 no-op + 기동 경고.
#                               체형사진은 클라이언트 SDK가 올리므로 서비스 자체는 돈다.
#   업로드(v2.25 트레이너 사진)  미설정 → POST /v1/staff/{uid}/photo 가 **503**.
#                               storage.rules가 staff/photos/** 의 클라이언트 쓰기를 전면
#                               차단해 뒀고(설계대로) Admin SDK만이 쓸 수 있다.
#
# 즉 **프로필 사진 업로드를 쓰려면 이 값이 필수다**(파기에는 선택). 업로드가 조용한 no-op으로
# 떨어지지 않는 이유: 그러면 어드민은 "저장됨"을 보고 회원앱은 빈 아바타를 본다 — 실제로 그
# 조용한 no-op이 버킷에 고아 파일 50개를 남긴 적이 있다(계약 v2.15 reconcile이 그 뒤처리다).
#
# 로컬(FIREBASE_PROJECT 미설정, 인메모리)에서는 Admin SDK 앱 자체가 없어 이 값을 채워도
# 업로드는 503이다. 로컬에서 트레이너 사진을 넣어 보려면 v1.6의 URL 직접 입력
# (PUT /v1/staff/{uid}/profile 의 photo_url)을 계속 쓴다 — 그 경로는 제거하지 않았다.
STORAGE_BUCKET=

# --- 기타 ---
# 어드민(React) 오리진(CORS). 콤마 구분. 어드민 vite dev 서버는 5174 포트(admin/vite.config.ts).
# (dev에서는 어드민이 /api 프록시로 same-origin 요청을 보내므로 CORS가 안 걸리지만,
#  프록시 없이 직접 연결하는 preview/배포 모드를 위해 기본값에 5174를 포함한다.)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

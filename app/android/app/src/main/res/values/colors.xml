<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        `flutter_launcher_icons`가 생성하는 값 — `pubspec.yaml`의
        `adaptive_icon_background: "#F6F4EF"`에서 온다. **재생성 시 덮어써지므로
        여기 손으로 다른 값을 넣지 말 것**(dart run flutter_launcher_icons).
    -->
    <color name="ic_launcher_background">#F6F4EF</color>

    <!--
        브랜드 크림. 위 값과 같은 색이지만 **출처가 다르다** — 이건 기동 창이 쓰고
        저건 런처 아이콘이 쓴다. 아이콘 재생성이 위 줄만 건드리게 이름을 나눠 둔다.

        `design/brand/rise-mark.svg` 헤더의 #F6F4EF와 같고, Flutter의
        `RiseMarkGeometry.cream`과도 같아야 한다 — 갈리면 기동 중 배경색이 튄다.
    -->
    <color name="brand_cream">#F6F4EF</color>
</resources>
